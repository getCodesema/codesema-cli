{
  "type": "object",
  "required": [
    "idempotency_key",
    "head_sha",
    "runbook_sha",
    "started_at",
    "finished_at",
    "status",
    "checks",
    "integrity_ok",
    "changed_dependency_files",
    "error"
  ],
  "properties": {
    "idempotency_key": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "head_sha": {
      "minLength": 1,
      "maxLength": 64,
      "type": "string"
    },
    "runbook_sha": {
      "pattern": "^[0-9a-f]{16}$",
      "type": "string"
    },
    "started_at": {
      "minLength": 1,
      "maxLength": 40,
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "const": "passed",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "refused",
          "type": "string"
        },
        {
          "const": "error",
          "type": "string"
        }
      ]
    },
    "checks": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "status",
          "exit_code",
          "duration_ms",
          "tail"
        ],
        "properties": {
          "command": {
            "minLength": 1,
            "maxLength": 500,
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "const": "passed",
                "type": "string"
              },
              {
                "const": "failed",
                "type": "string"
              },
              {
                "const": "timeout",
                "type": "string"
              },
              {
                "const": "skipped",
                "type": "string"
              }
            ]
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_ms": {
            "minimum": 0,
            "type": "number"
          },
          "tail": {
            "maxLength": 4000,
            "type": "string"
          }
        }
      }
    },
    "integrity_ok": {
      "type": "boolean"
    },
    "changed_dependency_files": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 500,
        "type": "string"
      }
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
